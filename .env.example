# GEMINI_API_KEY: Required for server-side Gemini AI support API calls (set in Settings > Secrets).
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_QUIZ_API_URL: External REST API endpoint used to dynamically fetch Quiz Job questions.
# Accepts Open Trivia DB, The Trivia API v2, or a custom JSON endpoint returning { questions: [...] } or [...].
VITE_QUIZ_API_URL="https://opentdb.com/api.php?amount=15&type=multiple"

