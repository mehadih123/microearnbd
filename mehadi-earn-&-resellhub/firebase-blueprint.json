        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "maxLength": 16
        },
        "balance": {
          "type": "number"
        },
        "pendingEscrowBalance": {
          "type": "number"
        },
        "coins": {
          "type": "number"
        },
        "memberTier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "isBlocked": {
          "type": "boolean"
        },
        "blockReason": {
          "type": "string",
          "maxLength": 300
        },
        "blockedAt": {
          "type": "string",
          "maxLength": 80
        },
        "joinedDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "name",
        "role",
        "balance",
        "pendingEscrowBalance",
        "coins",
        "memberTier",
        "isBlocked",
        "joinedDate",
        "createdAt",
        "updatedAt"
      ]
