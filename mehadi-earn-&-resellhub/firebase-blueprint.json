  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminRole",
      "description": "Trusted admin UID registry."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user operational profile and synced coin/BDT wallet."
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserPrivatePii",
      "description": "Isolated PII subcollection storing email and phone."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global reselling product catalog synced live across all devices."
    },
    "/jobs/{jobId}": {
      "schema": "MicroJob",
      "description": "Micro-job campaigns."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Reseller dropshipping orders."
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "WithdrawalRequest",
      "description": "User cashout requests."
    },
    "/proofs/{proofId}": {
      "schema": "TaskProof",
      "description": "Worker micro-job proof submissions."
    },
    "/feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "Support tickets, complaints, and blocked-account appeals."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial ledger entries per user."
    },
    "/settings/{settingId}": {
      "schema": "AdminSetting",
      "description": "Admin-only configuration settings."
    },
    "/gift_codes/{codeId}": {
      "schema": "GiftCode",
      "description": "Dynamic admin-managed promotional gift codes."
    }
  }
}
